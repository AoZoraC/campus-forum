# 环境变量示例文件
#
# 这个文件是给「部署时」看的：它列出项目运行需要哪些环境变量，
# 但**不含任何真实密钥**，所以可以安全地提交到 GitHub。
#
# 真正的 .env 里是填好的值，那个文件被 .gitignore 忽略、永远不会上传。
#
# ── 部署到 Vercel 时 ──
# 打开项目 → Settings → Environment Variables，
# 把下面这几项逐个加进去（值从你本地的 .env 里复制）。

# ─────────────────────────────────────────────
# 数据库（Supabase）
# ─────────────────────────────────────────────
# 网站运行时用：走连接池，端口 6543
DATABASE_URL="postgresql://postgres.项目ID:密码@aws-0-区域.pooler.supabase.com:6543/postgres?connect_timeout=30"

# 迁移建表时用：走直连，端口 5432
# 注意：部署到 Vercel 后，迁移要在**本地**跑（Vercel 的构建环境连不上直连地址），
# 命令是 npx prisma migrate deploy
DIRECT_URL="postgresql://postgres:密码@db.项目ID.supabase.co:5432/postgres?connect_timeout=30"

# ─────────────────────────────────────────────
# 站点地址
# ─────────────────────────────────────────────
# 用来拼出邮件里的验证链接。本地开发不用设（默认 http://localhost:3000）。
# 部署后填你的正式网址，例如 https://campus-forum.vercel.app
NEXT_PUBLIC_SITE_URL="https://你的域名"

# ─────────────────────────────────────────────
# 将来接真实邮件服务时要用（现在没接，先占个位置）
# ─────────────────────────────────────────────
# RESEND_API_KEY="re_xxxxxxxx"
